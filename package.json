{
  "name": "@seshuk/payload-plugin-sitemap",
  "version": "0.1.0",
  "description": "Sitemaps for Payload, generated by a job and stored through any Payload storage adapter.",
  "keywords": [
    "cms",
    "hreflang",
    "payload",
    "payload-plugin",
    "payloadcms",
    "plugin",
    "seo",
    "sitemap",
    "typescript"
  ],
  "homepage": "https://github.com/maximseshuk/payload-plugin-sitemap#readme",
  "bugs": "https://github.com/maximseshuk/payload-plugin-sitemap/issues",
  "license": "MIT",
  "author": "Maxim Seshuk",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maximseshuk/payload-plugin-sitemap.git"
  },
  "funding": {
    "type": "ko-fi",
    "url": "https://ko-fi.com/seshuk"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./client": {
      "types": "./src/client/index.ts",
      "import": "./src/client/index.ts",
      "default": "./src/client/index.ts"
    },
    "./rsc": {
      "types": "./src/rsc/index.ts",
      "import": "./src/rsc/index.ts",
      "default": "./src/rsc/index.ts"
    },
    "./fields": {
      "types": "./src/fields/index.ts",
      "import": "./src/fields/index.ts",
      "default": "./src/fields/index.ts"
    },
    "./proxy": {
      "types": "./src/site/sitemapProxy.ts",
      "import": "./src/site/sitemapProxy.ts",
      "default": "./src/site/sitemapProxy.ts"
    }
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      },
      "./client": {
        "types": "./dist/client/index.d.ts",
        "import": "./dist/client/index.js",
        "default": "./dist/client/index.js"
      },
      "./rsc": {
        "types": "./dist/rsc/index.d.ts",
        "import": "./dist/rsc/index.js",
        "default": "./dist/rsc/index.js"
      },
      "./fields": {
        "types": "./dist/fields/index.d.ts",
        "import": "./dist/fields/index.js",
        "default": "./dist/fields/index.js"
      },
      "./proxy": {
        "types": "./dist/site/sitemapProxy.d.ts",
        "import": "./dist/site/sitemapProxy.js",
        "default": "./dist/site/sitemapProxy.js"
      }
    },
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "cross-env PAYLOAD_CONFIG_PATH=./tests/payload.config.ts DATABASE_URL=file:./tests/payload.db next dev tests --port 3104",
    "dev:generate-importmap": "cd tests && cross-env PAYLOAD_CONFIG_PATH=./payload.config.ts payload generate:importmap",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "screenshots": "playwright test -c tests/playwright.screenshots.config.ts",
    "test": "vitest run -c tests/vitest.config.ts",
    "test:int": "vitest run -c tests/vitest.config.ts --project int",
    "test:stress": "cross-env STRESS=full vitest run -c tests/vitest.config.ts tests/integration/stress.int.spec.ts",
    "test:unit": "vitest run -c tests/vitest.config.ts --project unit",
    "test:watch": "vitest -c tests/vitest.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.9",
    "@electric-sql/pglite-socket": "0.2.12",
    "@payloadcms/db-mongodb": "^3.90.2",
    "@payloadcms/db-postgres": "^3.90.2",
    "@payloadcms/db-sqlite": "^3.90.2",
    "@payloadcms/next": "^3.90.2",
    "@payloadcms/plugin-multi-tenant": "^3.90.2",
    "@payloadcms/plugin-seo": "^3.90.2",
    "@payloadcms/storage-s3": "^3.90.2",
    "@payloadcms/translations": "^3.90.2",
    "@payloadcms/ui": "^3.90.2",
    "@playwright/test": "^1.64.0",
    "@scalar/openapi-types": "^0.9.8",
    "@seshuk/payload-plugin-tooling": "0.2.4",
    "@types/node": "^22.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "cross-env": "^10.1.0",
    "mongodb-memory-server": "^11.3.0",
    "next": "16.4.0",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "payload": "^3.90.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tsdown": "^0.23.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  },
  "peerDependencies": {
    "@payloadcms/next": "^3.83.0",
    "@payloadcms/translations": "^3.83.0",
    "@payloadcms/ui": "^3.83.0",
    "payload": "^3.83.0",
    "react": "^19.0.1 || ^19.1.2 || ^19.2.1",
    "react-dom": "^19.0.1 || ^19.1.2 || ^19.2.1"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^12.0.0",
      "onFail": "warn"
    },
    "runtime": {
      "name": "node",
      "version": ">=22.18.0",
      "onFail": "warn"
    }
  },
  "engines": {
    "node": ">=22"
  }
}
